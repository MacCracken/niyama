# tests/bre.bcyr — niyama_bre benchmarks.
#
# Per first-party-standards, capture a per-engine perf floor in the
# CHANGELOG. M1 ships a small representative corpus; the M5 hardening
# pass extends with stdlib-regex side-by-side comparisons + adversarial
# inputs.
#
# Run: cyrius bench tests/bre.bcyr

include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "src/bre.cyr"

# Persistent NFAs reused across iterations — compile cost is measured
# separately. Globals are bench-only; not part of niyama_bre's own state.
var _nfa_literal = 0;
var _nfa_dot_star = 0;
var _nfa_class = 0;
var _nfa_quantifier = 0;
var _nfa_anchored = 0;
var _nfa_group = 0;

var _input_short  = 0;  # ~32 byte input
var _input_long   = 0;  # ~512 byte input
var _input_quant  = 0;
var _input_anchor = 0;
var _input_group  = 0;

# === Compile benches ==================================================

fn bench_compile_literal() {
    var nfa = niyama_bre_compile("foobar");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn bench_compile_dot_star() {
    var nfa = niyama_bre_compile(".*foo.*bar");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn bench_compile_quantifier() {
    var nfa = niyama_bre_compile("a\\{3,8\\}b");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn bench_compile_group() {
    var nfa = niyama_bre_compile("\\(foo\\)\\(bar\\)");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

# === Search benches ===================================================

fn bench_search_literal_hit() {
    return niyama_bre_search(_nfa_literal, _input_long);
}

fn bench_search_literal_miss() {
    return niyama_bre_search(_nfa_literal, _input_short);
}

fn bench_search_dot_star() {
    return niyama_bre_search(_nfa_dot_star, _input_long);
}

fn bench_search_class() {
    return niyama_bre_search(_nfa_class, _input_long);
}

fn bench_search_quantifier() {
    return niyama_bre_search(_nfa_quantifier, _input_quant);
}

fn bench_search_anchored() {
    return niyama_bre_search(_nfa_anchored, _input_anchor);
}

fn bench_search_group() {
    return niyama_bre_search(_nfa_group, _input_group);
}

fn main() {
    alloc_init();

    # Pre-compile fixtures for search benches.
    _nfa_literal     = niyama_bre_compile("needle");
    _nfa_dot_star    = niyama_bre_compile(".*needle.*");
    _nfa_class       = niyama_bre_compile("[a-z]\\{4,\\}");
    _nfa_quantifier  = niyama_bre_compile("a\\{3,5\\}");
    _nfa_anchored    = niyama_bre_compile("^needle");
    _nfa_group       = niyama_bre_compile("\\(foo\\).*\\(bar\\)");

    _input_short  = "haystack with no match";
    _input_long   = "lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. needle is somewhere in the middle. ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat";
    _input_quant  = "xxx aaaa yyy aaaaaa zzz";
    _input_anchor = "needle is here at the start";
    _input_group  = "lorem foo ipsum dolor sit amet bar consectetur adipiscing";

    var benches = vec_new();

    var c1 = bench_new("bre_compile_literal");
    bench_run(c1, &bench_compile_literal, 10000);
    vec_push(benches, c1);

    var c2 = bench_new("bre_compile_dot_star");
    bench_run(c2, &bench_compile_dot_star, 10000);
    vec_push(benches, c2);

    var c3 = bench_new("bre_compile_quantifier");
    bench_run(c3, &bench_compile_quantifier, 10000);
    vec_push(benches, c3);

    var c4 = bench_new("bre_compile_group");
    bench_run(c4, &bench_compile_group, 10000);
    vec_push(benches, c4);

    var s1 = bench_new("bre_search_literal_hit");
    bench_run(s1, &bench_search_literal_hit, 10000);
    vec_push(benches, s1);

    var s2 = bench_new("bre_search_literal_miss");
    bench_run(s2, &bench_search_literal_miss, 10000);
    vec_push(benches, s2);

    var s3 = bench_new("bre_search_dot_star");
    bench_run(s3, &bench_search_dot_star, 1000);
    vec_push(benches, s3);

    var s4 = bench_new("bre_search_class");
    bench_run(s4, &bench_search_class, 1000);
    vec_push(benches, s4);

    var s5 = bench_new("bre_search_quantifier");
    bench_run(s5, &bench_search_quantifier, 10000);
    vec_push(benches, s5);

    var s6 = bench_new("bre_search_anchored");
    bench_run(s6, &bench_search_anchored, 100000);
    vec_push(benches, s6);

    var s7 = bench_new("bre_search_group");
    bench_run(s7, &bench_search_group, 1000);
    vec_push(benches, s7);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
