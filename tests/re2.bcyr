# tests/re2.bcyr — niyama_re2 benchmarks.
#
# Floor recorded for M5 hardening regression detection. The
# adversarial-pattern benches are the load-bearing measurement: they
# verify the linear-time guarantee holds at scale.
#
# Run: cyrius bench tests/re2.bcyr

include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "src/re2.cyr"

var _nfa_literal = 0;
var _nfa_alt = 0;
var _nfa_class = 0;
var _nfa_email = 0;
var _nfa_dos_alt = 0;       # (a|a)* — backtracking-killer
var _nfa_dos_nested = 0;    # (a*)*  — classic pathology
var _nfa_dos_optional = 0;  # a?{30}a{30} — Cox

var _input_short = 0;
var _input_long = 0;
var _input_email = 0;
var _input_dos = 0;          # 200 'a's

# === Compile benches =================================================

fn b_compile_literal() {
    var nfa = niyama_re2_compile("foobar");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_alt() {
    var nfa = niyama_re2_compile("cat|dog|fish");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_email() {
    var nfa = niyama_re2_compile("[a-z]+@[a-z]+\\.[a-z]+");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

# === Search benches ==================================================

fn b_search_literal() {
    return niyama_re2_search(_nfa_literal, _input_long);
}

fn b_search_alt() {
    return niyama_re2_search(_nfa_alt, _input_long);
}

fn b_search_class() {
    return niyama_re2_search(_nfa_class, _input_long);
}

fn b_search_email() {
    return niyama_re2_search(_nfa_email, _input_email);
}

# === Linear-time DoS-resistance benches (the load-bearing ones) ======

fn b_dos_alt() {
    # (a|a)* against 200 'a's with no terminator — backtracking would
    # explore 2^200 paths. Pike NFA: linear.
    return niyama_re2_match(_nfa_dos_alt, _input_dos);
}

fn b_dos_nested() {
    return niyama_re2_match(_nfa_dos_nested, _input_dos);
}

fn b_dos_optional() {
    # a?{30}a{30} against 30 'a's. Cox's adversary.
    return niyama_re2_match(_nfa_dos_optional, _input_dos);
}

fn fill_a(buf, n) {
    var i = 0;
    while (i < n) {
        store8(buf + i, 97);
        i = i + 1;
    }
    store8(buf + n, 0);
    return 0;
}

fn main() {
    alloc_init();

    _nfa_literal     = niyama_re2_compile("needle");
    _nfa_alt         = niyama_re2_compile("cat|dog|fish");
    _nfa_class       = niyama_re2_compile("[a-z]+\\d+");
    _nfa_email       = niyama_re2_compile("[a-z]+@[a-z]+\\.[a-z]+");
    _nfa_dos_alt     = niyama_re2_compile("(a|a)*b");
    _nfa_dos_nested  = niyama_re2_compile("(a*)*b");
    _nfa_dos_optional = niyama_re2_compile("a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");

    _input_short  = "needle in here";
    _input_long   = "lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. needle alice42 cat dog fish in the middle. user@example.com sits at the end of this corpus.";
    _input_email  = "send mail to user@example.com please";

    _input_dos = alloc(256);
    fill_a(_input_dos, 200);

    var benches = vec_new();

    var c1 = bench_new("re2_compile_literal");
    bench_run(c1, &b_compile_literal, 10000);
    vec_push(benches, c1);

    var c2 = bench_new("re2_compile_alt");
    bench_run(c2, &b_compile_alt, 10000);
    vec_push(benches, c2);

    var c3 = bench_new("re2_compile_email");
    bench_run(c3, &b_compile_email, 10000);
    vec_push(benches, c3);

    var s1 = bench_new("re2_search_literal");
    bench_run(s1, &b_search_literal, 10000);
    vec_push(benches, s1);

    var s2 = bench_new("re2_search_alt");
    bench_run(s2, &b_search_alt, 10000);
    vec_push(benches, s2);

    var s3 = bench_new("re2_search_class");
    bench_run(s3, &b_search_class, 1000);
    vec_push(benches, s3);

    var s4 = bench_new("re2_search_email");
    bench_run(s4, &b_search_email, 10000);
    vec_push(benches, s4);

    # The DoS-resistance benches — the headline numbers for niyama_re2.
    var d1 = bench_new("re2_dos_alt_explosion (200a)");
    bench_run(d1, &b_dos_alt, 1000);
    vec_push(benches, d1);

    var d2 = bench_new("re2_dos_nested_star (200a)");
    bench_run(d2, &b_dos_nested, 1000);
    vec_push(benches, d2);

    var d3 = bench_new("re2_dos_optional_chain (30a)");
    bench_run(d3, &b_dos_optional, 1000);
    vec_push(benches, d3);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
