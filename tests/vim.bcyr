# tests/vim.bcyr — niyama_vim benchmarks.
#
# Bench across all four magicness modes plus vim-specific feature
# benches (`\zs`/`\ze`, POSIX bracket classes).
#
# Run: cyrius bench tests/vim.bcyr

include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "src/vim.cyr"

var _h_magic = 0;
var _h_very_magic = 0;
var _h_nomagic = 0;
var _h_very_nomagic = 0;
var _h_zs_ze = 0;
var _h_posix = 0;
var _h_word_bound = 0;

var _input_short = 0;
var _input_long = 0;
var _input_zs_ze = 0;
var _input_word = 0;

# === Compile benches per mode ========================================

fn b_compile_magic() {
    var nfa = niyama_vim_compile("\\(foo\\)\\+");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_very_magic() {
    var nfa = niyama_vim_compile_opts("(foo)+", VIM_MODE_VERY_MAGIC);
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_nomagic() {
    var nfa = niyama_vim_compile_opts("\\(foo\\)\\+", VIM_MODE_NOMAGIC);
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_very_nomagic() {
    var nfa = niyama_vim_compile_opts("\\(foo\\)\\+", VIM_MODE_VERY_NOMAGIC);
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_zs_ze() {
    var nfa = niyama_vim_compile("foo\\zsbar\\zebaz");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

fn b_compile_posix() {
    var nfa = niyama_vim_compile("[[:alpha:]]\\+");
    if (nfa == 0) { return 0 - 1; }
    return 0;
}

# === Search benches ==================================================

fn b_search_magic() {
    return niyama_vim_search(_h_magic, _input_long);
}

fn b_search_very_magic() {
    return niyama_vim_search(_h_very_magic, _input_long);
}

fn b_search_nomagic() {
    return niyama_vim_search(_h_nomagic, _input_long);
}

fn b_search_very_nomagic() {
    return niyama_vim_search(_h_very_nomagic, _input_long);
}

fn b_search_zs_ze() {
    return niyama_vim_search(_h_zs_ze, _input_zs_ze);
}

fn b_search_posix() {
    return niyama_vim_search(_h_posix, _input_long);
}

fn b_search_word_bound() {
    return niyama_vim_search(_h_word_bound, _input_word);
}

fn main() {
    alloc_init();

    _h_magic         = niyama_vim_compile("\\(foo\\|bar\\)\\+");
    _h_very_magic    = niyama_vim_compile_opts("(foo|bar)+", VIM_MODE_VERY_MAGIC);
    _h_nomagic       = niyama_vim_compile_opts("\\(foo\\|bar\\)\\+", VIM_MODE_NOMAGIC);
    _h_very_nomagic  = niyama_vim_compile_opts("\\(foo\\|bar\\)\\+", VIM_MODE_VERY_NOMAGIC);
    _h_zs_ze         = niyama_vim_compile("foo\\zsbar\\zebaz");
    _h_posix         = niyama_vim_compile("[[:alpha:]]\\+");
    _h_word_bound    = niyama_vim_compile("\\<word\\>");

    _input_short = "foo";
    _input_long  = "lorem ipsum foo bar baz consectetur adipiscing elit foo bar in the middle";
    _input_zs_ze = "foobarbaz";
    _input_word  = "the word that we want here";

    var benches = vec_new();

    var c1 = bench_new("vim_compile_magic");
    bench_run(c1, &b_compile_magic, 10000);
    vec_push(benches, c1);

    var c2 = bench_new("vim_compile_very_magic");
    bench_run(c2, &b_compile_very_magic, 10000);
    vec_push(benches, c2);

    var c3 = bench_new("vim_compile_nomagic");
    bench_run(c3, &b_compile_nomagic, 10000);
    vec_push(benches, c3);

    var c4 = bench_new("vim_compile_very_nomagic");
    bench_run(c4, &b_compile_very_nomagic, 10000);
    vec_push(benches, c4);

    var c5 = bench_new("vim_compile_zs_ze");
    bench_run(c5, &b_compile_zs_ze, 10000);
    vec_push(benches, c5);

    var c6 = bench_new("vim_compile_posix");
    bench_run(c6, &b_compile_posix, 10000);
    vec_push(benches, c6);

    var s1 = bench_new("vim_search_magic");
    bench_run(s1, &b_search_magic, 10000);
    vec_push(benches, s1);

    var s2 = bench_new("vim_search_very_magic");
    bench_run(s2, &b_search_very_magic, 10000);
    vec_push(benches, s2);

    var s3 = bench_new("vim_search_nomagic");
    bench_run(s3, &b_search_nomagic, 10000);
    vec_push(benches, s3);

    var s4 = bench_new("vim_search_very_nomagic");
    bench_run(s4, &b_search_very_nomagic, 10000);
    vec_push(benches, s4);

    var s5 = bench_new("vim_search_zs_ze");
    bench_run(s5, &b_search_zs_ze, 10000);
    vec_push(benches, s5);

    var s6 = bench_new("vim_search_posix");
    bench_run(s6, &b_search_posix, 10000);
    vec_push(benches, s6);

    var s7 = bench_new("vim_search_word_bound");
    bench_run(s7, &b_search_word_bound, 10000);
    vec_push(benches, s7);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
