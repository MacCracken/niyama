# niyama — main entry point
# Stdlib auto-included via cyrius.cyml. niyama is primarily a library
# (engine modules under src/<flavor>.cyr); this main is a thin smoke
# entry that reports identity. Real CLI tooling (testing, benchmarks)
# lives in programs/ at each milestone.

fn main(): i64 {
    # The version is cyrius.cyml's [package].version — the VERSION file —
    # which `cyrius build` provides as CYRIUS_PKG_VERSION. A literal here went
    # stale (it printed 1.0.12 through 1.0.13). Every length is computed: a
    # hand-counted one over-read .rodata at 1.0.7.
    var head = "niyama ";
    var tail = " - additional regex engines (fold-ready: bre + re2 + pcre + fuzzy + vim)\n";
    syscall(1, 1, head, strlen(head));
    syscall(1, 1, CYRIUS_PKG_VERSION, strlen(CYRIUS_PKG_VERSION));
    syscall(1, 1, tail, strlen(tail));
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
