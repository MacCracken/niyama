# niyama.cyr -- bundled distribution
# Version: 0.5.0
# Status:  M3.5 — POSIX BRE + linear-time RE2 + Perl-compat PCRE +
#                 Levenshtein fuzzy engines shipped.
#
# Fold-ready single-include artifact. Following the sandhi precedent
# (cyrius v5.7.0 vendored `dist/sandhi.cyr` byte-identical as
# `lib/sandhi.cyr`), once niyama hits v1.0 with multi-consumer
# adoption, cyrius stdlib will vendor this file as `lib/niyama.cyr`
# per niyama ADR 0001.
#
# Until then, downstream consumers can vendor this file directly via
# `[deps.niyama]` in their cyrius.cyml.
#
# Engines shipped:
#   - bre   (M1, v0.2.0):   POSIX BRE — niyama_bre_*
#   - re2   (M2, v0.3.0):   ERE flavor + linear-time guarantee at API.
#                           niyama_re2_* — same shape as niyama_bre_*,
#                           with compile-time rejection of
#                           backref / lookaround / atomic / recursion.
#   - pcre  (M3, v0.4.0):   Perl-compat backtracking matcher.
#                           niyama_pcre_* — backref, lookahead, atomic,
#                           named captures, possessive quantifiers.
#                           Catastrophic-backtracking mitigated by
#                           configurable step-limit + recursion-depth
#                           bound (per ADR 0004).
#   - fuzzy (M3.5, v0.5.0): Levenshtein edit-distance matcher.
#                           niyama_fuzzy_* — anchored match + substring
#                           + prefix modes. Not regex. Per ADR 0005.
#   - vim: not yet shipped (see roadmap.md).
#
# Precondition: consumers MUST call alloc_init() before any
# niyama_*_compile() call.
#
# Do not edit -- rebuild with: scripts/build-dist.sh (post-M1)

var NIYAMA_VERSION = "0.5.0";

# === bre engine ======================================================
include "src/bre.cyr"

# === re2 engine ======================================================
include "src/re2.cyr"

# === pcre engine =====================================================
include "src/pcre.cyr"

# === fuzzy engine ====================================================
include "src/fuzzy.cyr"
