[package]
name = "niyama"
version = "0.3.0"
description = "niyama — additional regex engines (bre, re2, pcre, fuzzy, vim) for the AGNOS-lineage Cyrius ecosystem; foldable into stdlib per sandhi pattern"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "5.8.42"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "niyama"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert"]
---
